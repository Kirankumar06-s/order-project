
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code is ready'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Order Project'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing Order Project'
            }
        }

        stage('Complete') {
            steps {
                echo 'Order Project completed successfully!'
            }
        }
    }
}
